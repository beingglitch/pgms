generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  VACATED
}

enum LedgerType {
  RENT
  DEPOSIT
  REFUND
  OTHER
}

enum PaymentMode {
  UPI
  CASH
  BANK_TRANSFER
  CHEQUE
}

enum ReminderType {
  RENT
  ELECTRICITY
  OTHER
}

enum ReminderStatus {
  PENDING
  DONE
}

enum ExpenseFrequency {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum ChargeType {
  RENT
  ELECTRICITY
  LAUNDRY
  OTHER
}

/// One PG owner's business: the tenant root everything else hangs off of.
/// Was a disguised singleton (`id: "singleton"`, one shared password) before
/// the app went multi-tenant; now a normal row per signup, keyed by email.
model Account {
  id                     String  @id @default(cuid())
  /// Login identifier. Email is kept for record-keeping but no longer used
  /// to sign in.
  username               String  @unique
  email                  String  @unique
  name                   String  @default("My PG")
  shortName              String  @default("PG")
  logoUrl                String?
  address                String  @default("")
  /// Map-picked location, from the onboarding wizard. Null when skipped.
  latitude               Float?
  longitude              Float?
  contact                String  @default("")
  totalBeds              Int     @default(0)
  paymentLink            String  @default("")
  ownerName              String  @default("Owner")
  electricityRatePerUnit Decimal @db.Decimal(10, 2) @default(8)

  /// Null until the first-run onboarding wizard is finished (or skipped
  /// through to the end); gates the redirect in app/(app)/layout.tsx.
  onboardingCompletedAt DateTime?

  /// Window the dashboard "due soon" counter looks ahead by.
  dueSoonDays      Int       @default(7)
  /// How many days before the 1st next month's rent charge is created, so
  /// it's on the books (and chaseable) ahead of the due date.
  dueLeadDays      Int       @default(7)
  /// Month (1 = Jan ... 12 = Dec) the financial year starts on, for the
  /// dashboard's "collected this year" figure. India's FY runs April to
  /// March, hence the default of 4.
  fiscalYearStartMonth Int   @default(4)
  /// scrypt hash of the owner's password.
  passwordHash     String
  createdAt        DateTime  @default(now())

  floors            Floor[]
  rooms             Room[]
  tenants           Tenant[]
  charges           Charge[]
  ledgerEntries     LedgerEntry[]
  electricityBills  ElectricityBill[]
  expenses          Expense[]
  reminders         Reminder[]
  activityLogs      ActivityLog[]
}

model Floor {
  id        String     @id @default(cuid())
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  name      String
  order     Int        @default(0)
  rooms     Room[]
  createdAt DateTime   @default(now())

  @@unique([accountId, name])
  @@index([accountId])
}

model Room {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  floor     Floor   @relation(fields: [floorId], references: [id], onDelete: Cascade)
  floorId String
  number  String
  /// Number of beds: 1 single, 2 double, 3 triple, and so on.
  capacity Int    @default(1)
  /// Rent for the whole room, split evenly across whoever currently lives
  /// there.
  rentAmount Decimal @db.Decimal(10, 2) @default(0)
  note      String?
  createdAt DateTime   @default(now())

  tenants       Tenant[]
  meterReadings ElectricityBill[]

  @@unique([floorId, number])
  @@index([accountId])
}

model Tenant {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  name       String
  phone      String
  email      String?
  fatherName String?
  motherName String?

  room       Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId     String?
  /// Free-text room label, kept for tenants not yet mapped to a Room record.
  roomNumber String?
  bedNumber  String?
  /// Fallback rent for tenants with no room. Prefer the room split; see
  /// effectiveRent() in lib/charges.ts for the resolution order.
  rentAmount    Decimal @db.Decimal(10, 2)
  /// Set to pin this tenant's rent regardless of the room split.
  rentOverride  Decimal? @db.Decimal(10, 2)
  depositAmount Decimal @db.Decimal(10, 2)
  depositMethod       PaymentMode @default(CASH)
  depositChequeNumber String?
  depositChequeBank   String?

  joinDate      DateTime
  /// Overrides joinDate as the anchor for future rent cycles. Set when this
  /// tenant moved into a room that already had someone in it: their first
  /// charge is pro-rated up to the existing roommate's own due-day, and every
  /// cycle after that is anchored here instead, so the room settles onto one
  /// shared due date rather than two.
  rentCycleAnchor DateTime?
  pan           String?
  idProofType   String  @default("Aadhaar")
  idProofNumber String?
  aadhaarFrontUrl String?
  aadhaarBackUrl  String?
  photoUrl        String?

  carNumber String?
  carModel  String?
  address   String?

  emergencyContact String?
  emergencyPhone   String?
  notes            String?

  status       TenantStatus   @default(ACTIVE)
  /// Date the tenant gave notice, and the date they expect to leave. Drives
  /// the vacancy forecast and deposit-refund planning.
  noticeDate         DateTime?
  expectedVacateDate DateTime?
  vacatedDate  DateTime?
  refundAmount Decimal?       @db.Decimal(10, 2)
  refundMethod PaymentMode?
  refundChequeNumber String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agreements         Agreement[]
  ledgerEntries      LedgerEntry[]
  electricityBills   ElectricityBill[]
  reminders          Reminder[]
  checkoutDeductions CheckoutDeduction[]
  charges            Charge[]

  @@index([status])
  @@index([roomId])
  @@index([accountId])
}

/// Something the tenant owes. Payments are matched to charges through
/// Allocation, so a charge can be partly paid and the shortfall stays visible.
model Charge {
  id          String     @id @default(cuid())
  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  type        ChargeType
  /// Billing month this charge belongs to, as "YYYY-MM".
  period      String
  description String
  amount      Decimal    @db.Decimal(10, 2)
  dueDate     DateTime
  /// Set when the charge was generated from a meter reading.
  sourceBill   ElectricityBill? @relation(fields: [sourceBillId], references: [id], onDelete: Cascade)
  sourceBillId String?
  /// Written off, still shown for the record, but not counted as owed.
  waived      Boolean    @default(false)
  createdBy   String?
  createdAt   DateTime   @default(now())

  allocations Allocation[]

  /// Double-billing the same tenant for the same rent cycle is impossible at
  /// the database level: a partial unique index on (tenantId, period) WHERE
  /// type = 'RENT', not expressible in this schema syntax, so it lives only
  /// in migration 20260810160000_rent_charge_unique_rent_only and is NOT
  /// regenerated from this file. It deliberately excludes ELECTRICITY/OTHER/
  /// LAUNDRY: manual charges and multiple meter readings in one month are
  /// legitimately allowed to repeat a (tenantId, period, type) combination.
  /// A future `prisma migrate diff` against this schema will try to drop it
  /// as drift; don't let it, or hand-edit the generated migration to keep it.
  @@index([tenantId, period])
  @@index([dueDate])
  @@index([type])
  @@index([accountId])
}

/// Links money received to the charge it settles. One payment can be spread
/// across several charges, and one charge can be settled by several payments.
model Allocation {
  id            String      @id @default(cuid())
  charge        Charge      @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  chargeId      String
  ledgerEntry   LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  ledgerEntryId String
  amount        Decimal     @db.Decimal(10, 2)

  @@index([chargeId])
  @@index([ledgerEntryId])
}

model Agreement {
  id                String   @id @default(cuid())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId          String
  version           Int
  effectiveDate     DateTime
  roomNumber        String?
  rentAmount        Decimal  @db.Decimal(10, 2)
  depositAmount     Decimal  @db.Decimal(10, 2)
  depositRefundable Boolean  @default(true)
  electricityRate   Decimal  @db.Decimal(10, 2) @default(8)
  laundryChargeable Boolean  @default(true)
  laundryCharge     Decimal  @db.Decimal(10, 2) @default(300)
  facilities        Json     @default("[]")
  photoUrl          String?
  note              String?
  changeNote        String?
  changedBy         String?
  createdAt         DateTime @default(now())

  @@index([tenantId])
}

model LedgerEntry {
  id         String      @id @default(cuid())
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  type       LedgerType
  amount     Decimal     @db.Decimal(10, 2)
  date       DateTime
  mode       PaymentMode @default(UPI)
  note       String?
  /// Sequential receipt number, e.g. "R-202608-0004". Unique per account -
  /// two properties both number their own receipts from R-...-0001.
  receiptNo  String?
  recordedBy String?
  createdAt  DateTime    @default(now())

  allocations Allocation[]

  @@unique([accountId, receiptNo])
  @@index([tenantId])
  @@index([date])
  @@index([accountId])
}

model ElectricityBill {
  id           String   @id @default(cuid())
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId    String
  /// Room the sub-meter belongs to. A room meter is read once and split across
  /// whoever is living there, so readings hang off the room, not a tenant.
  room         Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId       String?
  /// Legacy per-tenant readings taken before rooms existed.
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String?
  isMainMeter  Boolean  @default(false)
  startReading Decimal  @db.Decimal(10, 2)
  startDate    DateTime
  /// Rate at the moment the reading was opened. Fixed at that point rather
  /// than re-read when closed, so the total matches whatever was implied
  /// when the reading (and its proof photo) was first captured.
  ratePerUnit  Decimal  @db.Decimal(10, 2)
  photoUrl     String?
  /// Null means this reading is open: started (with a starting number and a
  /// proof photo, typically captured at onboarding), but not yet closed out
  /// with a current number. Every place that reports totals or seeds the
  /// next reading's starting value must exclude open rows explicitly,
  /// they're not "zero units", they're "not billed yet".
  endReading Decimal?  @db.Decimal(10, 2)
  endDate    DateTime?
  units      Decimal?  @db.Decimal(10, 2)
  amount     Decimal?  @db.Decimal(10, 2)
  recordedBy String?
  createdAt  DateTime  @default(now())

  charges  Charge[]
  expenses Expense[]

  @@index([tenantId])
  @@index([roomId])
  @@index([isMainMeter])
  @@index([endDate])
  @@index([accountId])
}

model CheckoutDeduction {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  reason    String
  amount    Decimal  @db.Decimal(10, 2)
  category  String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Expense {
  id         String           @id @default(cuid())
  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  title      String
  category   String
  amount     Decimal          @db.Decimal(10, 2)
  frequency  ExpenseFrequency @default(ONE_TIME)
  date       DateTime
  note       String?
  receiptUrl String?
  recordedBy String?
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())

  /// Set when the expense was raised automatically from a main-meter reading,
  /// so deleting the reading cleans up the expense instead of orphaning it.
  sourceBill   ElectricityBill? @relation(fields: [sourceBillId], references: [id], onDelete: Cascade)
  sourceBillId String?

  @@index([accountId])
  @@index([frequency])
  @@index([date])
  @@index([sourceBillId])
}

model Reminder {
  id        String         @id @default(cuid())
  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  tenant    Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String?
  type      ReminderType   @default(RENT)
  title     String
  dueDate   DateTime
  amount    Decimal?       @db.Decimal(10, 2)
  note      String?
  status    ReminderStatus @default(PENDING)
  createdBy String?
  createdAt DateTime       @default(now())

  @@index([tenantId])
  @@index([status])
  @@index([accountId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  actor  String
  action String
  detail String?
  ts     DateTime @default(now())

  @@index([accountId])
}
